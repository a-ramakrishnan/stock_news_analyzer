# Copy to .env and adjust. .env is never committed.

# Postgres started by `make up` (port 5433 on the laptop).
DATABASE_URL=postgresql+psycopg://sna:sna@localhost:5433/sna

# Raw files (PDFs, transcripts) and reports go here.
DATA_DIR=data

TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO

# Unusual-move threshold, in standard deviations of the last 60 days (2.0 flags ~5% of days).
UNUSUAL_THRESHOLD=2.0

# Phase 2 (LLM agents): an API key from console.anthropic.com.
# The key, budget, models and unusual threshold can instead be set on the dashboard's Settings
# page; a value saved there takes the place of the one here.
ANTHROPIC_API_KEY=

# Model per kind of work, and a monthly spending cap in US dollars (calls stop when reached).
LLM_MODEL_TRIAGE=claude-haiku-5-5
LLM_MODEL_ANALYSIS=claude-sonnet-5-5
LLM_MONTHLY_BUDGET_USD=20
